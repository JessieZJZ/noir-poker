{
  "pages": [
    "pages/table/table",
    "pages/records/records",
    "pages/history/history",
    "pages/source/source"
  ],
  "resizable": true,
  "subpackages": [
    {
      "root": "music",
      "name": "music",
      "pages": ["loader"]
    },
    {
      "root": "tutorial",
      "name": "tutorial",
      "pages": ["loader"]
    },
    {
      "root": "calculator",
      "name": "calculator",
      "pages": ["win-rate"]
    },
    {
      "root": "sounds",
      "name": "sounds",
      "pages": ["loader"]
    }
  ],
  "workers": {
    "path": "workers",
    "isSubpackage": true
  },
  "window": {
    "pageOrientation": "portrait",
    "navigationStyle": "custom",
    "backgroundColor": "#0a1016",
    "backgroundTextStyle": "light"
  },
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "preloadRule": {
    "pages/table/table": {
      "network": "all",
      "packages": ["tutorial", "sounds"]
    }
  }
}
