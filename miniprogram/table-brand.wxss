.tool-brand {
  display: flex;
  flex: none;
  align-items: center;
  gap: 6px;
  min-height: 32px;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 1px;
  white-space: nowrap;
}
.tool-brand-icon {
  width: 22px;
  height: 22px;
  border-radius: 5px;
}
.tool-brand-sub {
  color: #96adb9;
  font-size: 10px;
  font-weight: 400;
}
