<view class="records-chrome" style="height: {{topInset + 36}}px;" />
<view
  class="records-screen"
  style="padding-top: {{topInset + 36}}px; padding-bottom: {{bottomInset + 20}}px;"
>
  <view class="records-nav"
    ><button id="records-back" bindtap="returnToGame">‹ 返回游戏</button><text>对局记录</text></view
  >
  <view class="records-intro"
    ><text>每一局的练习足迹</text><text>浏览记录时，当前游戏继续进行。</text></view
  >
  <view wx:if="{{!sessions.length}}" class="records-empty"
    >还没有对局记录，开始练习后自动保存。</view
  >
  <view wx:if="{{recordsError}}" class="records-empty">{{recordsError}}</view>
  <view
    wx:for="{{sessions}}"
    wx:key="id"
    wx:for-item="session"
    class="records-session"
    data-id="{{session.id}}"
  >
    <view
      class="session-item"
      bindtap="toggleSession"
      data-id="{{session.id}}"
      aria-role="button"
      aria-expanded="{{expanded[session.id] ? 'true' : 'false'}}"
    >
      <view class="session-item-heading"
        ><text>第 {{session.number}} 局</text
        ><view class="session-heading-end"
          ><text class="session-status">{{session.endedAt ? '已结束' : '进行中'}}</text
          ><view
            class="session-toggle {{expanded[session.id] ? 'is-expanded' : ''}}"
            aria-hidden="true"
            ><view class="session-chevron" /></view></view
      ></view>
      <text class="session-time">{{session.timeText}}</text>
      <view class="session-metrics"
        ><view><text>胜率</text><text>{{session.winrate}}%</text></view
        ><view
          ><text>净筹码变化</text
          ><text class="{{session.profit > 0 ? 'positive' : session.profit < 0 ? 'negative' : ''}}"
            >{{session.profitText}}</text
          ></view
        ></view
      >
      <view class="session-config"
        ><text>起始盲注 {{session.blindText}}</text><text>{{session.playerCount}} 人桌</text></view
      >
    </view>
    <view wx:if="{{expanded[session.id]}}" class="hand-list">
      <view
        wx:for="{{session.attempts}}"
        wx:key="id"
        class="hand-item {{item.superseded ? 'superseded' : ''}} {{item.status !== 'completed' ? 'is-disabled' : ''}}"
        data-id="{{item.id}}"
        bindtap="openHand"
        aria-role="button"
        aria-disabled="{{item.status !== 'completed' ? 'true' : 'false'}}"
      >
        <view class="hand-cards"
          ><view
            wx:for="{{item.cards}}"
            wx:for-item="card"
            wx:key="key"
            class="record-card {{card.red ? 'red' : ''}}"
            style="{{card.artStyle}}"
            aria-label="{{card.rank}}{{card.suit}}"
        /></view>
        <view class="hand-details"
          ><view class="hand-item-title"
            ><text>第 {{item.hand}} 手</text
            ><text wx:if="{{item.attemptText}}" class="hand-tag hand-replay"
              >{{item.attemptText}}</text
            ></view
          ><view wx:if="{{item.refill || item.resultText}}" class="hand-tags"
            ><text wx:if="{{item.refill}}" class="hand-tag">补码</text
            ><text wx:if="{{item.resultText}}">{{item.resultText}}</text></view
          ></view
        >
        <text
          class="hand-profit {{item.profit > 0 ? 'positive' : item.profit < 0 ? 'negative' : ''}}"
          >{{item.profitText}}</text
        >
      </view>
    </view>
  </view>
  <text class="records-note"
    >记录保存在本机。胜率按获得底池计算；重打只将最后采用的结果计入本局。</text
  >
</view>
