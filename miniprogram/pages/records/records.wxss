@import '../../shared/ui/game-effects.wxss';
/* Mirrors the Web records list at phone width (src/styles/game-records.css). */
page {
  background: #0b1017;
  color: #edf3f6;
}
.records-chrome {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: #0b1017;
}
.records-screen {
  padding: 0 12px;
}
.records-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
  font-size: 19px;
  font-weight: 600;
  line-height: 1.4;
}
.records-empty {
  padding: 36px 20px;
  text-align: center;
  color: #91a8b1;
  font-size: 13px;
  line-height: 1.8;
}
.records-session {
  border: 1px solid #2d404b;
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 18px;
  background: #111d26;
}
.session-item {
  position: relative;
  width: 100%;
  margin: 0;
  padding: 16px 56px 18px 16px;
  background: transparent;
}
.session-title {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
}
.session-number {
  font-size: 17px;
  font-weight: 600;
}
.session-time {
  color: #9cafb7;
  font-size: 12px;
}
.session-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px 12px;
  margin-top: 18px;
}
.session-stats view {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.session-stats view text:first-child {
  color: #8fa7b1;
  font-size: 12px;
}
.session-stats view text:last-child {
  font-size: 17px;
  font-weight: 500;
}
.session-toggle {
  position: absolute;
  top: 50%;
  right: 16px;
  width: 30px;
  height: 30px;
  margin-top: -15px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9fd9c4;
  transition: transform 180ms ease;
}
.session-chevron {
  width: 8px;
  height: 8px;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: translateY(-2px) rotate(45deg);
}
.session-toggle.is-expanded {
  transform: rotate(180deg);
}
.hand-list {
  padding: 4px 10px 8px;
  border-top: 1px solid #293d47;
  background: #0e1820;
}
.hand-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  margin: 0;
  padding: 14px 0;
  background: transparent;
  border-bottom: 1px solid #25343e;
}
.hand-item.is-disabled {
  background: transparent;
}
.hand-item:last-child {
  border-bottom: 0;
}
.hand-cards {
  display: flex;
  gap: 4px;
  flex: none;
}
.record-card {
  width: 31px;
  height: 44px;
  border-radius: 4px;
  background-color: #f4f8f5;
  background-size: 100% 100%;
  box-shadow: 0 2px 4px #0005;
}
.hand-details {
  flex: 1;
  min-width: 0;
}
.hand-title {
  display: block;
  font-size: 14px;
  font-weight: 500;
}
.hand-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  margin-top: 7px;
}
.hand-tag {
  padding: 1px 4px;
  border: 1px solid #3b4c53;
  border-radius: 4px;
  color: #a2b6bd;
  font-size: 10px;
  line-height: 1.4;
}
.hand-tag.hand-replay {
  border-color: #7f659c;
  color: #d8bef4;
  background: #332640;
}
.hand-tag.hand-refill {
  border-color: #326857;
  color: #89d9bd;
  background: #163c31;
}
.hand-result {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  max-width: 35%;
  text-align: right;
}
.hand-profit {
  font-size: 16px;
  font-weight: 600;
}
.hand-outcome {
  color: #8ea6ad;
  font-size: 11px;
  line-height: 1.5;
}
.hand-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 16px;
  height: 24px;
  color: #768e96;
}
.hand-chevron {
  width: 7px;
  height: 7px;
  border-top: 2px solid currentColor;
  border-right: 2px solid currentColor;
  transform: translateX(-2px) rotate(45deg);
}
.positive {
  color: #6ee7c5;
}
.negative {
  color: #ef8a9a;
}
.records-more {
  margin: 10px 0;
  padding: 8px 12px;
  color: #a5c9c0;
  background: #14272c;
  border: 1px solid #304b56;
  border-radius: 8px;
  font-size: 13px;
}
.compliance-footer {
  display: block;
  padding: 8px 16px 14px;
  text-align: center;
  font-size: 11px;
  letter-spacing: 1px;
  color: #6b7a87;
}
