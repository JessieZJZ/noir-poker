page {
  background: #0a1117;
  color: #dce9ed;
}
.records-chrome {
  position: fixed;
  inset: 0 0 auto;
  z-index: 20;
  background: #0a1117;
}
.records-screen {
  padding: 0 16px;
}
.records-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 64px;
  font-size: 19px;
  font-weight: 700;
}
.records-nav button {
  margin: 0;
  color: #adc2ca;
  background: #15212a;
  border: 1px solid #30434e;
  border-radius: 10px;
  padding: 8px 12px;
  font-size: 13px;
}
.records-intro {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 8px 0 20px;
}
.records-intro text:first-child {
  font-size: 24px;
  font-weight: 700;
}
.records-intro text:last-child,
.records-note,
.records-empty {
  font-size: 12px;
  color: #8ea8b5;
  line-height: 1.7;
}
.records-empty {
  padding: 22px 16px;
  border: 1px solid #29404a;
  border-radius: 14px;
  margin-bottom: 12px;
}
.records-session {
  border: 1px solid #2b414c;
  border-radius: 15px;
  overflow: hidden;
  margin-bottom: 14px;
  background: #101d25;
}
.session-item {
  color: #dce9ed;
  width: 100%;
  text-align: left;
  margin: 0;
  padding: 16px;
  background: transparent;
  border-radius: 0;
}
.session-item-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 18px;
  font-weight: 700;
}
.session-status {
  color: #8faab6;
  font-size: 11px;
  font-weight: 500;
}
.session-heading-end {
  display: flex;
  align-items: center;
  gap: 10px;
}
.session-toggle {
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #38525d;
  border-radius: 50%;
  color: #80dcc9;
  background: #152a32;
}
.session-chevron {
  width: 7px;
  height: 7px;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: translateY(-2px) rotate(45deg);
}
.session-toggle.is-expanded .session-chevron {
  transform: translateY(2px) rotate(225deg);
}
.session-time {
  display: block;
  margin-top: 4px;
  color: #8faab6;
  font-size: 11px;
}
.session-metrics {
  display: flex;
  gap: 28px;
  margin-top: 16px;
}
.session-metrics view {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.session-metrics view text:first-child {
  font-size: 11px;
  color: #8faab6;
}
.session-metrics view text:last-child {
  font-size: 24px;
  font-weight: 700;
}
.session-config {
  display: flex;
  gap: 15px;
  margin-top: 13px;
  color: #adc0c9;
  font-size: 12px;
}
.hand-list {
  border-top: 1px solid #2b414c;
  padding: 0 12px;
}
.hand-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  margin: 0;
  padding: 15px 0;
  color: #dce9ed;
  background: transparent;
  text-align: left;
  border-bottom: 1px solid #243944;
  border-radius: 0;
}
.hand-item:last-child {
  border-bottom: 0;
}
.hand-item.is-disabled {
  color: #9aafb8;
  background: transparent;
}
.hand-cards {
  display: flex;
  gap: 3px;
  flex: none;
}
.record-card {
  width: 28px;
  height: 40px;
  border-radius: 4px;
  background-color: #f4f8f5;
  background-size: 100% 100%;
  box-shadow: 0 2px 4px #0005;
}
.hand-details {
  flex: 1;
  min-width: 0;
}
.hand-item-title {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  font-size: 13px;
}
.hand-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 6px;
  color: #9db4bf;
  font-size: 10px;
}
.hand-tag {
  color: #a7cec1;
  border: 1px solid #35594e;
  border-radius: 4px;
  padding: 0 4px;
}
.hand-tag.hand-replay {
  color: #ecd397;
  border-color: #796534;
  background: rgba(121, 101, 52, 0.18);
  font-size: 10px;
  font-weight: 600;
  white-space: nowrap;
}
.hand-profit {
  flex: none;
  font-size: 16px;
  font-weight: 700;
}
.positive {
  color: #6ee7c5;
}
.negative {
  color: #ff929d;
}
.superseded {
  opacity: 0.7;
}
.records-note {
  display: block;
  margin: 20px 4px;
}
