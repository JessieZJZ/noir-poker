/* Keep card art in the same 64×92 coordinates as Web's SVG faces. */
.card {
  background: linear-gradient(145deg, #fffdf8, #f3f5f0 58%, #e5eeec);
  color: #223447;
  padding: 0;
  box-sizing: border-box;
}
.card.red {
  color: #c74760;
}
.card .card-rank,
.card .card-corner {
  font-family: Manrope, sans-serif;
  position: absolute;
  width: 31.25%;
  padding: 0;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}
.card .card-rank {
  left: 0;
  top: 3.26%;
}
.card .card-corner {
  right: 0;
  bottom: 3.26%;
}
.card .card-suit {
  position: absolute;
  left: 27.34375%;
  top: 32.663%;
  width: 45.3125%;
  height: 34.674%;
  padding: 0;
  background-position: center;
  background-size: contain;
  background-repeat: no-repeat;
}
.card.mini-card {
  padding: 0;
}
.mini-card-rank {
  position: absolute;
  top: 4%;
  left: 13.889%;
  font:
    700 14.22px/1.2 Manrope,
    sans-serif;
}
.card .mini-card-suit {
  position: absolute;
  left: 31.944%;
  top: 47.3%;
  width: 47.222%;
  height: 37.4%;
  background-position: center;
  background-size: contain;
  background-repeat: no-repeat;
}
.card.review-card-face .card-rank,
.card.review-card-face .card-corner {
  font-size: 7.969px;
}
.review-step-number {
  text-align: center;
}
.seat.folded {
  opacity: 0.4;
}
.folded .seat-body {
  opacity: 1;
}
.folded .seat-hole {
  opacity: 0.4;
}
.is-done .seat.folded {
  opacity: 1;
}
.is-done .folded .seat-name,
.is-done .folded .avatar,
.is-done .folded .stack {
  opacity: 0.45;
}

.game-shell.has-showdown {
  border-bottom-color: #101b22;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  background: #101b22;
}
.showdown-stage {
  margin: 0;
  padding: 19px 14px 17px;
  background: #101b22;
  border: 1px solid #28353f;
  border-top: 0;
  border-radius: 0 0 18px 18px;
}
.showdown-heading .eyebrow {
  display: inline;
  color: #b7a57d;
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 600;
}
.showdown-context {
  display: block;
  margin-top: 7px;
  color: #b9c8c7;
  font-size: 12px;
}
.showdown-scene {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12px;
  padding-top: 17px;
}
.showdown-player {
  padding: 15px;
  border: 1px solid #2c4342;
  border-radius: 11px;
  background: #12232a;
}
.showdown-winner {
  border-color: #8b794a;
  background: linear-gradient(145deg, #3b382322, #14252a);
}
.showdown-player-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 13px;
  font-size: 14px;
}
.showdown-player-heading > text:first-child {
  font-weight: 600;
  line-height: 1.5;
  color: #e0eae7;
}
.showdown-player-heading > text:last-child {
  font-size: 12px;
  color: #8fa9a6;
  white-space: nowrap;
}
.showdown-winner .showdown-player-heading > text:last-child {
  color: #ebd097;
}
.winning-title > text {
  display: block;
}
.winning-title > text:first-child {
  font-size: 24px;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 1px;
  color: #c4dbd1;
}
.showdown-winner .winning-title > text:first-child {
  color: #f4d99e;
}
.winning-title > text:last-child {
  font-size: 12px;
  line-height: 1.6;
  margin-top: 5px;
  color: #99b3ab;
}
.winning-cards {
  display: flex;
  justify-content: center;
  gap: 7px;
  padding: 4px;
  margin: 16px 0 12px;
}
.showdown-card {
  width: 43px;
  height: 62px;
}
.showdown-card .card-rank,
.showdown-card .card-corner {
  font-size: 10.078px;
}
.rank-match .showdown-card {
  outline: 1px solid #77b6a6;
  outline-offset: 2px;
}
.showdown-winner .rank-match .showdown-card {
  outline-color: #dfc285;
}
.winning-card.kicker {
  opacity: 0.7;
}
.showdown-awards {
  display: block;
  padding-top: 10px;
  border-top: 1px solid #34504466;
  font-size: 12px;
  line-height: 1.8;
  color: #95aea6;
}
.showdown-winner .showdown-awards {
  color: #d5c391;
}
.showdown-winner .winning-card.kicker {
  opacity: 1;
}
/* Web's dialog button stays inline-block, so adjacent margins do not collapse. */
.pot-sheet .return-button {
  display: inline-block !important;
  padding: 14px 20px;
  line-height: 1.5;
  font-weight: 600;
  vertical-align: top;
}

.review-label.consider {
  background: #65573266;
  color: #e4cea0;
}
.review-label.sound {
  background: #284e4266;
  color: #a7d6bd;
}
.review-practice-focus {
  padding: 14px 16px;
  border-left: 2px solid #e4cea0;
  background: #65573233;
}
.review-practice-focus .module-title {
  color: #e4cea0;
}
.review-evidence,
.review-public-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 18px 0;
  font-size: 14px;
  line-height: 1.8;
}
.review-scope {
  display: block;
  margin-top: 18px;
  font-size: 12px;
  line-height: 1.8;
}

.review-activity {
  margin-top: 24px;
  border-top: 1px solid #30434e;
  padding-top: 16px;
  color: #91a7b2;
}
.review-activity-toggle {
  width: 100%;
  padding: 8px 0;
  text-align: left;
  background: transparent;
  color: #c8dbdf;
  font-weight: 700;
}
.review-activity-event {
  padding: 10px 12px;
  line-height: 1.65;
  border-radius: 8px;
}
.review-activity-emphasis {
  color: #edf7f5;
  font-weight: 750;
}
.review-activity-current {
  box-shadow: inset 3px 0 #6be2c5;
  background: #66cbb124;
}
.review-analysis-heading {
  display: block;
  color: #e4cea0;
  font-size: 14px;
  font-weight: 500;
  margin: 24px 0 12px;
}

/* Center the grown artwork independently of the original fixed hero footprint. */
.web-phone-layout .hero-cards-wrap {
  display: flex;
  justify-content: center;
  align-self: center;
  flex: none;
  position: relative;
}
.web-phone-layout .hero-cards-wrap > .hero-cards {
  flex: none;
  width: 100%;
}
.review-sheet .review-analysis-heading,
.review-sheet .review-evidence .module-title,
.review-sheet .review-activity-toggle {
  color: #e4cea0;
  font-size: 14px;
  font-weight: 500;
}
.review-sheet .review-matchups .module-title {
  color: #e4cea0;
  font-size: 13px;
  font-weight: 500;
}
.review-practice-focus > text {
  display: block;
}
.review-practice-focus > text + text {
  margin-top: 5px;
}
.review-sheet .review-evidence {
  display: block;
  margin: 18px 0 0;
  padding: 16px 18px;
  border: 1px solid #374950;
  border-radius: 9px;
  background: #16272b;
}
.review-evidence > text {
  display: block;
  color: #aebfb8;
  font-size: 13px;
  line-height: 1.9;
}
.review-evidence > .module-title {
  margin-bottom: 12px;
}
.activity-position {
  display: inline-block;
  padding: 1px 5px;
  margin: 0 3px;
  border: 1px solid #50776b;
  border-radius: 4px;
  background: #203c36;
  color: #bde5d8;
  font-size: 11px;
  box-sizing: border-box;
  height: 20px;
  line-height: 16px;
  vertical-align: top;
  white-space: nowrap;
}

.review-coaching {
  margin: 20px 0;
}
.review-matchups > view {
  margin-bottom: 0;
}
.review-matchups view > .module-title,
.review-matchup-example {
  margin-bottom: 12px;
}
.review-matchup-caption {
  font-size: 0.833333em;
}
.review-evidence-facts {
  margin-top: 12px;
  color: #aebfb8;
  font-size: 13px;
  line-height: 1.9;
}
.review-evidence-fact {
  display: flex;
  gap: 8px;
}
.review-evidence-fact > text + text {
  flex: 1;
  min-width: 0;
}
@media (max-width: 760px) {
  .review-coaching.opponent-reason > text,
  .opponent-reason .review-matchups {
    font-size: 13px;
    line-height: 1.85;
  }
  .review-coaching.opponent-reason > text,
  .opponent-reason .review-matchup-hand,
  .opponent-reason .review-matchup-example,
  .opponent-reason .review-range-note {
    margin-bottom: 17px;
  }
}
