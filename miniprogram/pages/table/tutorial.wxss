/* Mirrors src/styles/tutorial.css: same colors, sizes and pulse as Web. */
.tutorial-coach {
  position: relative;
  display: flex;
  flex: none;
  flex-direction: column;
  box-sizing: border-box;
  height: 176px;
  margin: 4px 0 6px;
  padding: 8px 12px 10px;
  border: 1px solid rgba(110, 231, 197, 0.34);
  border-radius: 14px;
  background: #101c23;
}
.tutorial-coach-top {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: space-between;
  height: 28px;
}
.tutorial-lesson {
  overflow: hidden;
  color: #6ee7c5;
  font-size: 12px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tutorial-coach .tutorial-exit {
  flex: none;
  width: auto;
  min-width: 0;
  height: 28px;
  margin: 0;
  padding: 0 2px;
  border: 0;
  background: none;
  color: #8897a6;
  font-size: 12px;
  font-weight: 400;
  line-height: 28px;
}
.tutorial-progress {
  flex: none;
  height: 3px;
  margin: 3px 0 6px;
  overflow: hidden;
  border-radius: 2px;
  background: #25313d;
}
.tutorial-progress view {
  height: 100%;
  background: #6ee7c5;
  transition: width 0.3s ease;
}
.tutorial-message {
  flex: 1 1 0;
  min-height: 0;
  height: 0;
}
.tutorial-title {
  margin-right: 6px;
  color: #6ee7c5;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.5;
}
.tutorial-text,
.tutorial-detail {
  color: #cfdbe2;
  font-size: 14px;
  line-height: 1.5;
}
.tutorial-detail {
  display: block;
}
.tutorial-options {
  display: grid;
  flex: none;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-top: 4px;
}
.tutorial-options button {
  width: auto;
  min-width: 0;
  min-height: 34px;
  margin: 0;
  padding: 4px 6px;
  border: 1px solid #25313d;
  border-radius: 9px;
  background: #1a2732;
  color: #edf3f6;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.2;
  white-space: normal;
}
.tutorial-options button.is-wrong {
  border-color: #e56f80;
  color: #e56f80;
}
.tutorial-coach .tutorial-next {
  float: right;
  width: auto;
  min-width: 84px;
  height: 32px;
  margin: 0 0 4px 10px;
  padding: 0 12px;
  border: 0;
  border-radius: 9px;
  background: #6ee7c5;
  color: #06231c;
  font-size: 14px;
  font-weight: 800;
  line-height: 32px;
}
.action-dock.tutorial-short-dock {
  height: 127px;
  flex-basis: 127px;
}
.action-dock.tutorial-short-dock .raise-track {
  display: none;
}
/* Landscape tablets: the panel leaves the shell, whose overflow would clip it. */
.game-shell.tutorial-side {
  margin-right: 312px;
}
.tutorial-side .tutorial-coach {
  position: fixed;
  right: 9px;
  z-index: 3;
  width: 300px;
  height: auto;
  margin: 0;
}
.tutorial-side .tutorial-options {
  grid-template-columns: minmax(0, 1fr);
}
@media (min-width: 601px) and (min-height: 601px) {
  .tutorial-lesson,
  .tutorial-coach .tutorial-exit {
    font-size: 14px;
  }
  .tutorial-title {
    font-size: 17px;
  }
  .tutorial-text,
  .tutorial-detail {
    font-size: 16px;
  }
  .tutorial-options button {
    min-height: 44px;
    font-size: 16px;
  }
  .tutorial-coach .tutorial-next {
    height: 44px;
    font-size: 16px;
    line-height: 44px;
  }
}
.tutorial-focus {
  box-shadow: 0 0 0 2px #ffc857;
  border-radius: 8px;
  animation: tutorial-focus 1.6s ease-in-out infinite;
}
@keyframes tutorial-focus {
  50% {
    box-shadow: 0 0 0 2px rgba(255, 200, 87, 0.3);
  }
}
.tutorial-sheet {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 16px 20px 18px;
}
.tutorial-sheet-scroll {
  flex: 1 1 auto;
  max-height: 58vh;
  margin-top: 8px;
}
.tutorial-sheet-title {
  color: #edf3f6;
  font-size: 22px;
  font-weight: 700;
}
.tutorial-sheet-lead {
  margin: 10px 0 14px;
  color: #cfdbe2;
  font-size: 14px;
  line-height: 1.6;
}
.tutorial-step {
  display: flex;
  gap: 10px;
  margin-bottom: 10px;
}
.tutorial-step-number {
  flex: none;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #153d36;
  color: #6ee7c5;
  font-size: 13px;
  font-weight: 800;
  line-height: 26px;
  text-align: center;
}
.tutorial-step-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.tutorial-step-title {
  color: #edf3f6;
  font-size: 15px;
  font-weight: 700;
}
.tutorial-step-text {
  color: #8897a6;
  font-size: 13px;
  line-height: 1.45;
}
.tutorial-point {
  display: flex;
  gap: 10px;
  margin-bottom: 10px;
  color: #cfdbe2;
  font-size: 14px;
  line-height: 1.5;
}
.tutorial-point-dot {
  flex: none;
  width: 7px;
  height: 7px;
  margin-top: 7px;
  border-radius: 50%;
  background: #6ee7c5;
}
.tutorial-sheet-note {
  margin-top: 4px;
  color: #8897a6;
  font-size: 13px;
  line-height: 1.5;
}
.tutorial-sheet-actions {
  display: flex;
  flex: none;
  gap: 10px;
  margin-top: 14px;
}
.tutorial-sheet-actions button {
  width: auto;
  min-width: 0;
  height: 48px;
  margin: 0;
  border: 0;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 800;
  line-height: 48px;
}
.tutorial-sheet-actions .quiet {
  flex: 0 0 34%;
  background: none;
  color: #cfdbe2;
}
.tutorial-sheet-actions .primary {
  flex: 1;
  background: #6ee7c5;
  color: #06231c;
}
