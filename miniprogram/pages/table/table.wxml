<page-meta
  page-orientation="{{pageOrientation}}"
  bindresize="onResize"
  page-style="{{homeLocked ? 'overflow: hidden;' : ''}}"
/>
<import src="./table-templates.wxml" />
<wxs module="rail" src="./raise-rail.wxs" />

<view wx:if="{{!tableReady}}" class="launch-screen" aria-label="NOIR Poker">
  <image src="/assets/launch-icon.png" mode="aspectFit" />
  <text class="launch-wordmark">NOIR POKER</text>
  <view class="launch-progress" />
</view>
<include src="./table-surface.wxml" />
<page-container
  show="{{tutorialActive || exitGuard}}"
  overlay="{{false}}"
  duration="{{0}}"
  z-index="{{0}}"
  custom-style="height: 0; overflow: hidden; background: transparent;"
  bind:beforeleave="pageBack"
/>
