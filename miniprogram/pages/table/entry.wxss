.nav-actions {
  left: 0;
  gap: 10px;
}
.nav-actions .settings-button {
  display: flex;
  gap: 7px;
  width: auto;
  min-width: 66px;
  max-width: none;
  height: 44px;
  padding: 0 7px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #b9c7d0;
  font-size: 12px;
  font-weight: 400;
  line-height: 1.4;
}
.nav-actions .guide-button {
  font-size: 12px;
  font-weight: 400;
  line-height: 1.4;
}
.nav-actions .settings-button .gear-icon {
  width: 19px;
  height: 19px;
}

.practice-home,
.nav.practice-home-nav {
  width: 100%;
  max-width: 414px;
  align-self: center;
  padding-right: 8px;
  padding-left: 8px;
}
.practice-home-nav .brand,
.practice-home-nav .brand-sub {
  color: #edf7f5;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.4px;
}
.practice-home-nav .brand {
  gap: 5px;
}
.practice-home {
  --home-ink: #edf7f5;
  --home-muted: #a1b7b5;
  --home-surface: #132127;
  --home-border: #304548;
  padding-top: 14px;
  padding-bottom: 18px;
  color: var(--home-ink);
  line-height: 1.5;
}
.practice-home-title {
  display: block;
  font-size: 31px;
  font-weight: 700;
  line-height: 1.2;
}
.practice-home-intro,
.practice-home-lesson-copy,
.practice-home-note {
  display: block;
  color: var(--home-muted);
}
.practice-home-intro {
  margin: 7px 0 18px;
  font-size: 14px;
}
.practice-home-lesson {
  padding: 16px;
  border: 1px solid var(--home-border);
  border-radius: 15px;
  background: #143532;
}
.practice-home-lesson-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
}
.practice-home-lesson-title {
  display: block;
  font-size: 19px;
  font-weight: 700;
  line-height: 1.3;
}
.practice-home-lesson-copy {
  margin-top: 5px;
  font-size: 13px;
}
.practice-home-cards {
  display: flex;
  flex: none;
  gap: 4px;
  font-size: 13px;
  font-weight: 700;
}
.practice-home-cards > text {
  padding: 5px;
  border: 1px solid var(--home-border);
  border-radius: 5px;
  background: var(--home-surface);
}
.practice-home-heart {
  color: #ff9ca8;
}
.practice-home button {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 44px;
  border: 1px solid var(--home-border);
  border-radius: 9px;
  background: var(--home-surface);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.4;
  text-align: left;
}
.practice-home .practice-home-tutorial,
.practice-home .practice-home-join {
  justify-content: space-between;
  /* The native button component otherwise applies its 184px default width. */
  width: 100% !important;
  margin-right: 0;
  margin-left: 0;
  gap: 8px;
}
.practice-home .practice-home-tutorial {
  margin-top: 14px;
  padding: 8px 12px;
  font-weight: 600;
}
.practice-home-arrow {
  font-size: 18px;
}
.practice-home-tools {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}
.practice-home-tools button {
  flex: 1;
  gap: 7px;
  padding: 8px 10px;
}
.practice-home-rank-icon,
.practice-home-calc-icon {
  position: relative;
  flex: 0 0 14px;
  height: 14px;
}
.practice-home-rank-icon > view {
  position: absolute;
  top: 1px;
  left: 3px;
  width: 9px;
  height: 9px;
  transform: rotate(45deg);
  border: 1px solid currentColor;
  border-radius: 2px;
  background: var(--home-surface);
}
.practice-home-rank-icon > view:first-child {
  top: 4px;
}
.practice-home-calc-icon {
  border: 1px solid currentColor;
  border-radius: 2px;
}
.practice-home-calc-icon::before,
.practice-home-calc-icon::after {
  position: absolute;
  left: 2px;
  right: 2px;
  border-top: 1px solid currentColor;
  content: '';
}
.practice-home-calc-icon::before {
  top: 3px;
}
.practice-home-calc-icon::after {
  top: 7px;
  border-top-style: dotted;
}
.practice-home .practice-home-join {
  min-height: 58px;
  margin-top: 15px;
  padding: 9px 11px 9px 15px;
  border: 0;
  border-radius: 12px;
  background: #80ddc9;
  color: #0b2825;
  font-size: 18px;
  font-weight: 700;
}
.practice-home-join-arrow {
  display: flex;
  flex: 0 0 36px;
  align-items: center;
  justify-content: center;
  height: 36px;
  border-radius: 9px;
  background: rgba(11, 40, 37, 0.13);
  font-size: 24px;
  line-height: 1;
}
.practice-home button.practice-home-pressed {
  opacity: 0.8;
}
.practice-home-note {
  margin-top: 12px;
  font-size: 12px;
  text-align: center;
}

@media (max-width: 380px) {
  .practice-home-lesson {
    padding: 12px;
  }
  .nav.practice-home-nav {
    gap: 4px;
    padding-inline: 2px;
  }
}
