}
.table-short .seat-action {
  min-height: 14px;
  font-size: 7px;
  line-height: 7px;
}
.table-short .community {
  /* The shortest screen's crown captions leave no room to lift this band. */
  top: 50%;
  transform: translate(-50%, -59px);
}
.table-short .hero {
  bottom: 7px;
}
.table-short .pot-row {
  height: 25px;
  margin-bottom: 3px;
}
.table-short .community-card,
.table-short .card-placeholder {
  width: 25px;
  height: 32px;
}
.table-short .community-card .card-rank {
