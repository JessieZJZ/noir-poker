}
.web-phone-layout .seat .seat-name-measure {
  position: absolute;
  left: 0;
  top: 0;
  width: max-content;
  white-space: nowrap;
  visibility: hidden;
  pointer-events: none;
}
.web-phone-layout .seat .seat-name-label.is-name-fitted {
  overflow: visible;
  text-overflow: clip;
  transform: scaleX(var(--name-width-scale, 1));
  transform-origin: left center;
}
.web-phone-layout .seat .seat-body {
  grid-template-rows: var(--player-name) auto var(--player-stack);
  padding: var(--profile-padding);
  padding-top: calc(var(--profile-padding) + 1px);
}
.web-phone-layout .seat .persona {
  height: calc(var(--player-persona) * 1.15 + 4px);
  min-height: calc(var(--player-persona) * 1.15 + 4px);
  max-height: calc(var(--player-persona) * 1.15 + 4px);
}
.web-phone-layout .seat .card-back {
  flex: none;
  width: var(--player-back-width);
  height: var(--player-back-height);
  transform: translateY(var(--player-back-shift)) rotate(-7deg);
}
.web-phone-layout .seat .card-back + .card-back {
  transform: translateY(var(--player-back-shift)) rotate(7deg);
}
.action-notice {
