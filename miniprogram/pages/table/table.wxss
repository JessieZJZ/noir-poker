/* Three bounded side rows leave the hero identity a separate footer.
   All four top seats fit beside each other at the 320px screen boundary. */
.table-short .seat {
  width: 54px;
  transform: translateX(-50%);
}
.table-short .seat-hole {
  height: 20px;
}
.table-short .seat-hole.revealed-hole {
  height: 20px;
}
.table-short .card-back {
  width: 14px;
  height: 18px;
  transform: translateY(10px) rotate(-7deg);
}
.table-short .card-back + .card-back {
  transform: translateY(10px) rotate(7deg);
}
.table-short .mini-card {
  width: 17px;
  height: 24px;
  --hole-inset: 4px;
  transform: translateY(var(--hole-inset));
  padding: 1px;
  font-size: 7px;
  line-height: 7px;
