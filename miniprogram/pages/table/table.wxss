}
.table-short .seat-name .position {
  font-size: 6px;
  padding: 0 2px;
}
.table-short .seat-persona {
  min-height: 10px;
  height: 10px;
  margin: 0;
  gap: 2px;
}
.table-short .avatar {
  width: 9px;
  height: 9px;
}
.table-short .persona {
  min-width: 0;
  font-size: 7px;
  line-height: 8px;
  padding: 0 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.table-short .persona-balanced {
  min-width: 24px;
  font-size: 8px;
  line-height: 9px;
}
.table-short .seat-body .stack {
  font-size: 8px;
  line-height: 9px;
}
.table-short .seat-caption {
  min-height: 24px;
  height: 24px;
