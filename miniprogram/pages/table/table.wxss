}
.web-phone-layout .position {
  padding: 1px 5px;
  line-height: 1.1;
}
.web-phone-layout .seat .position {
  padding-inline: 3px;
}
.web-phone-layout .hero-action {
  height: var(--hero-action-height);
  line-height: 1.2;
}
.web-phone-layout .seat .seat-caption {
  position: relative;
  width: var(--caption-width);
  left: 50%;
  transform: translateX(-50%);
}
.web-phone-layout .seat .seat-name,
.web-phone-layout .seat .seat-body > .stack {
  line-height: 1;
}
.web-phone-layout .seat .seat-name {
