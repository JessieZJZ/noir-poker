.resource-menu {
  position: absolute;
  top: 46px;
  right: 0;
  width: 140px;
  padding: 5px;
  z-index: 72;
  border: 1px solid #31434e;
  border-radius: 12px;
  background: #14212a;
  box-shadow: 0 12px 34px #0008;
}
.resource-menu button {
  display: block;
  width: 100%;
  padding: 10px 12px;
  text-align: left;
  color: #d8e7ec;
  background: transparent;
  font-size: 14px;
}
.resource-dismiss {
  position: fixed;
  inset: 0;
  z-index: 68;
}
.nav.resource-menu-active {
  z-index: 70;
}
.nav-actions {
  position: relative;
  left: 6px;
  z-index: 70;
  gap: 4px;
}
.guide-button {
  width: 88px;
  max-width: 88px;
  font-size: 13px;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  animation-duration: 0.4s;
}
.resource-label-window {
  position: relative;
  height: 20px;
  width: 64px;
  line-height: 20px;
  overflow: hidden;
}
.resource-label-current,
.resource-label-previous,
.resource-label-static {
  position: absolute;
  inset: 0;
  display: block;
}
.resource-label-previous,
.resource-label-static {
  display: none;
}
.resource-label-window.is-rolling .resource-label-current {
  animation: resource-label-in 0.4s ease-out both;
}
.resource-label-window.is-rolling .resource-label-previous {
  display: block;
  animation: resource-label-out 0.4s ease-out both;
}
@keyframes resource-label-in {
  from {
    transform: translateY(-100%);
  }
  to {
    transform: translateY(0);
  }
}
@keyframes resource-label-out {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(100%);
  }
}
@media (prefers-reduced-motion: reduce) {
  .guide-button {
    animation-duration: 0s;
  }
  .resource-label-window .resource-label-current,
  .resource-label-window .resource-label-previous {
    display: none;
    animation: none;
  }
  .resource-label-window .resource-label-static {
    display: block;
  }
}
.history-return-game {
