/* Compact actions remove unused controls without changing the table itself. */
.action-dock.compact-actions {
  flex: 0 0 64px;
  height: 64px;
  padding: 10px 8px;
}
.compact-actions .settled-buttons,
.compact-actions .continue-buttons {
  width: 100%;
  height: 38px;
  margin: 0;
}
.compact-actions .settled-buttons button,
.compact-actions .continue-buttons button {
  min-width: 0;
  height: 38px;
  font-size: 12px;
}
.action-dock button[disabled] {
  opacity: 1;
  background: #16212a;
  border: 1px solid #26333e;
  color: #596b77;
}
.is-enabled .action-notice {
  color: #d6f5e9;
}
.table-area:not(.table-short) .community-card,
.table-area:not(.table-short) .card-placeholder {
  width: 38px;
  height: 55px;
}

