}
.history-shell .settled-buttons {
  grid-template-columns: minmax(0, 1fr);
}
.history-shell .action-dock {
  flex: 0 0 64px;
  height: 64px;
  padding: 10px 8px;
}
.web-phone-layout .hero-cards {
  height: var(--hero-card-slot-height);
  min-height: var(--hero-card-slot-height);
  align-items: flex-start;
  gap: var(--hero-card-gap);
}
.web-phone-layout .hero-card {
  position: relative;
  top: calc(-1 * var(--hero-card-shift));
  transform: rotate(var(--hero-card-left-angle));
}
.web-phone-layout .hero-card + .hero-card {
  transform: rotate(var(--hero-card-right-angle));
}
.web-phone-layout .seat .seat-body > .stack {
