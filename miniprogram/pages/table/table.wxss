}
.table-short .community-card .card-suit {
  font-size: 17px;
}
.table-short .board-row {
  margin-bottom: 3px;
  row-gap: 7px;
}
.table-short .hero-card {
  width: 42px;
  height: 56px;
}
.table-short .hero-card .card-rank {
  font-size: 13px;
}
.table-short .hero-card .card-suit {
