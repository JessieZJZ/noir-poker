/* Every page ends close to the compliance footer, as on Web. */
.compliance-footer {
  padding: 8px 16px 14px;
}

/* Emotion legend in Settings, as on Web. */
.mood-legend {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 10px;
}
.mood-legend-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  color: #95a8b0;
  font-size: 12px;
  line-height: 1.6;
}
.mood-legend-item .mood-badge {
  flex: none;
  width: 16px;
  height: 16px;
  margin-top: 2px;
}
.mood-legend-name {
  color: #d6dfe2;
  font-weight: 600;
}
