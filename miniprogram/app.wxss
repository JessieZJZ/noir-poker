page {
  background: #0b1218;
  color: #eaf1f3;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}
view,
text,
button,
scroll-view {
  box-sizing: border-box;
}
button {
  margin: 0;
  padding: 0;
  color: inherit;
  font-size: inherit;
  line-height: normal;
  border-radius: 9px;
  background: transparent;
}
button::after {
  border: 0;
}
button[disabled] {
  color: #66808b;
  background: #15232c;
  opacity: 0.55;
}
