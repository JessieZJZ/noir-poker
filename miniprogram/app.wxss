@import 'fonts.wxss';
page {
  font-family: Manrope, 'Noto Sans SC', sans-serif;
  -webkit-text-size-adjust: 100%;
  background: #0b1017;
  color: #edf3f6;
}
view,
text,
button,
scroll-view {
  box-sizing: border-box;
}
button {
  margin: 0;
  padding: 0;
  color: inherit;
  font-family: inherit;
  font-size: inherit;
  line-height: normal;
  border-radius: 9px;
  background: transparent;
}
button::after {
  border: 0;
}
button[disabled] {
  color: #66808b;
  background: #15232c;
  opacity: 0.55;
}
