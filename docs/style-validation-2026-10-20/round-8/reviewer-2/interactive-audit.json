  "definitions": {
    "vpip": "Hand with at least one voluntary preflop call or raise (positive call/raise decisions); forced blinds and free checks excluded.",
    "pfr": "Hand with at least one preflop raise.",
    "saw_flop": "Board has at least 3 cards and actor did not fold preflop; includes preflop all-in runout separately identified.",
    "observer_only_target_flop": "Hero folded preflop while target reached flop, counted from final public events; these are observation, not actual shared flop.",
    "faces_bet": "Decision owing chips to the most recent current-street raiser when that raiser is the other named party; intervening calls do not change aggressor, intervening raises do. Distinct decisions and distinct hands both reported.",
    "target_unobserved_hole": "Never infer bluff/value from unknown hole cards.",
    "sample_limit": "Different deal sequences and unequal encounter opportunity counts; no win-rate or personality inference."
  }
